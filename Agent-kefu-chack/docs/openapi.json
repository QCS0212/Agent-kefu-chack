  "components": {
    "schemas": {
      "CheckRequest": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "mock",
              "llm"
            ],
            "title": "Mode",
            "default": "mock"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Reply"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "CheckRequest"
      },
      "EvaluationRequest": {
        "properties": {
          "labels": {
            "items": {
              "$ref": "#/components/schemas/Label"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Labels"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "labels"
        ],
        "title": "EvaluationRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Label": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Id"
          },
          "is_hallucination": {
            "type": "boolean",
            "title": "Is Hallucination"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "is_hallucination"
        ],
        "title": "Label"
      },
      "Reply": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Id"
          },
          "user_question": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "User Question"
          },
          "system_reply": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "System Reply"
          },
          "knowledge_base": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Knowledge Base"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "user_question",
          "system_reply",
          "knowledge_base"
        ],
        "title": "Reply"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
