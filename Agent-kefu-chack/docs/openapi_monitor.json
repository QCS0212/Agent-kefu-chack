  "components": {
    "schemas": {
      "Claim": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "relation": {
            "type": "string",
            "enum": [
              "supported",
              "contradicted",
              "unsupported",
              "not_verifiable"
            ],
            "title": "Relation"
          },
          "reply_quote": {
            "type": "string",
            "title": "Reply Quote",
            "default": ""
          },
          "knowledge_quote": {
            "type": "string",
            "title": "Knowledge Quote",
            "default": ""
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "text",
          "relation"
        ],
        "title": "Claim"
      },
      "DetectionRecord": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "hallucination",
              "no_hallucination",
              "not_verifiable"
            ],
            "title": "Verdict"
          },
          "types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Types"
          },
          "severity": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Severity"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "title": "Claims"
          },
          "detector": {
            "type": "string",
            "enum": [
              "rule",
              "llm",
              "mock",
              "knowledge_gap",
              "fallback"
            ],
            "title": "Detector"
          },
          "needs_review": {
            "type": "boolean",
            "title": "Needs Review",
            "default": false
          },
          "knowledge_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Knowledge Version"
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms",
            "default": 0
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "verdict",
          "reason",
          "detector"
        ],
        "title": "DetectionRecord"
      },
      "EventDocument": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
