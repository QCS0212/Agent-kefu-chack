# 复制为 .env 后按需修改。真实密钥只写在本地 .env，不要提交。
# 环境变量优先于本文件；两个服务共用仓库根目录的同一个 .env。

# ========== 通用 ==========
# 日志：LOG_JSON=1 输出单行 JSON（便于 ELK/Loki 采集）；LOG_CONFIGURE=0 时不接管日志配置
LOG_LEVEL=INFO
LOG_JSON=1

# ========== 批量检测 API（app/，默认 127.0.0.1:8000）==========
# 真实模型（Chat Completions 兼容）。缺配置时 mock 仍可运行，mode=llm 会明确报错而不是回退 mock。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 监听地址：绑非本机地址（如 0.0.0.0）时必须配置 API_KEYS，否则服务拒绝启动
API_BIND_HOST=127.0.0.1
API_PORT=8000

# 接入密钥与额度（企业格式，多条用分号分隔）：
#   <token>|<tenant>|<scopes>|<daily_quota>|<rate_per_minute>
# scopes：detect / read / admin；quota=0 不限，rate=0 不限
# 例：API_KEYS=sk-cs-9f2a|customer-service|detect,read|2000|120;sk-ops|customer-service|detect,read,admin|0|600
API_KEYS=

# 单批上限、并发与队列
API_MAX_BATCH=20
API_MAX_RUNNING=2
API_MAX_QUEUED=8

# 未在 Key 上单独指定时的默认限流与每日配额
API_RATE_LIMIT=120
API_DAILY_QUOTA=0

# Idempotency-Key 记录保留天数
API_IDEMPOTENCY_TTL_DAYS=7

# 允许的浏览器来源（逗号分隔），用于面板联调
API_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# ========== 监测平台（monitor/，默认 127.0.0.1:8010）==========
# 服务监听：默认只绑本机。要让外部系统调用，改为 0.0.0.0 并务必配置令牌
MONITOR_BIND_HOST=127.0.0.1
MONITOR_BIND_PORT=8010

# 上游批量检测服务地址与模式（mock=规则模拟，llm=真实模型）
MONITOR_UPSTREAM_URL=http://127.0.0.1:8000
MONITOR_UPSTREAM_MODE=mock
# 上游要求鉴权时必填：需具备 detect scope，取值与 API_KEYS 中的某个 token 一致
MONITOR_UPSTREAM_API_KEY=

# 接入密钥（企业格式，多条用分号分隔，语义同 API_KEYS）
# 例：MONITOR_API_KEYS=sk-cc-a1b2|customer-service|ingest,read|0|600;sk-ops|ops|ingest,read,admin|0|600
MONITOR_API_KEYS=
# 兼容旧格式：纯令牌逗号分隔（等价 tenant=default、全部 scope、不限额度）
MONITOR_API_TOKENS=change-me-token-1
# 关闭接入鉴权（仅本机调试用，不要用于对外环境）
MONITOR_REQUIRE_AUTH=1
# 每分钟接入请求上限，0=不限
MONITOR_RATE_LIMIT=120
# 每个 Key 的每日接入条数上限，0=不限
MONITOR_DAILY_QUOTA=0

# 只读接口保护令牌：配置后读接口需要该令牌
MONITOR_PANEL_TOKEN=
# 是否强制读接口鉴权（默认 0=本机开放；绑非本机地址或配置面板令牌时自动强制）
MONITOR_REQUIRE_READ_AUTH=0

# 数据库与知识目录
MONITOR_DB=data/monitor.db
MONITOR_KNOWLEDGE_DIR=knowledge

# 知识源：file=只用本地 knowledge/；shop=调用商城只读知识接口（推荐，能拿到真实退改政策与订单/退款记录）
MONITOR_KNOWLEDGE_SOURCE=file
# 商城只读知识接口（契约见 docs/SHOP_INTEGRATION.md）；智选票示例：
#   http://127.0.0.1:6085/zhixuanpiao/customize/knowledge/get
MONITOR_SHOP_KNOWLEDGE_URL=
MONITOR_SHOP_TOKEN=
MONITOR_SHOP_TIMEOUT=5
# 商城接口不可用时是否回退本地 knowledge/（none=不回退，直接标记不可核验）
MONITOR_SHOP_FALLBACK=file

# 方式二：直连商城只读库（MONITOR_KNOWLEDGE_SOURCE=mysql 时生效）
# 强烈建议使用仅 SELECT 权限的账号，账号只能看到下面列出的库
MONITOR_SHOP_DB_HOST=127.0.0.1
MONITOR_SHOP_DB_PORT=3306
MONITOR_SHOP_DB_USER=
MONITOR_SHOP_DB_PASSWORD=
# 分库前缀与分片后缀（智选票为 zhixuanpiao_program_0/1、order_0/1、pay_0/1）
MONITOR_SHOP_DB_PROGRAM=zhixuanpiao_program
MONITOR_SHOP_DB_ORDER=zhixuanpiao_order
MONITOR_SHOP_DB_PAY=zhixuanpiao_pay
MONITOR_SHOP_DB_SUFFIXES=0,1

# 抽样：高风险类目全量，其余按概率（哈希抽样，同一会话结论稳定）
MONITOR_SAMPLE_RATE=1.0
MONITOR_ALWAYS_SAMPLE=after_sale,payment,product

# 规则快检：执行类声明与编造联系人按新语义处理（明确否定能力才判幻觉；否则待人工复核）
MONITOR_RULE_FAST_CHECK=1

# 告警：high 立即推 webhook（HMAC 签名头 X-Monitor-Signature），medium 聚合日报
MONITOR_ALERT_WEBHOOK_URL=
MONITOR_ALERT_SECRET=
MONITOR_ALERT_MIN_SEVERITY=medium
MONITOR_ALERT_DEDUP_MINUTES=30
# 夜间静默，如 22:00-08:00
MONITOR_QUIET_HOURS=

# 工作循环
MONITOR_WORKER_INTERVAL=5
MONITOR_WORKER_BATCH=20

# 单次接入最多接收的事件数，0=不限（防止单请求压垮存储）
MONITOR_MAX_BATCH_ITEMS=200

# 上游失败重试：最多重试次数与指数退避基数（秒）。重试耗尽才记为不可核验
MONITOR_RETRY_MAX_ATTEMPTS=3
MONITOR_RETRY_BACKOFF_SECONDS=30

# 会话数据保留天数，0=永久保留；工作循环会定期清理超期数据
MONITOR_RETENTION_DAYS=30

# 前端面板跨域来源，逗号分隔；留空走 vite 代理
MONITOR_CORS_ORIGINS=